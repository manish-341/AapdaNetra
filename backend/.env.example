PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/AapdaNetraDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/AapdaNetraDB

# Security & Authentication
JWT_SECRET=your_super_secret_production_key_here
JWT_EXPIRE=7d

# Frontend Domain (Required for CORS in production)
# Example: https://aapdanetra.vercel.app
FRONTEND_URL=http://localhost:5173

# External AI & Weather Services (Optional / Recommended)
OPENAI_API_KEY=your_openai_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
AI_SERVICE_URL=http://localhost:8000

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
