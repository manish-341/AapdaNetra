{
  "project": "AapdaNetra",
  "prediction_target": {
    "name": "landslide_risk",
    "type": "binary_classification",
    "positive_class": 1,
    "negative_class": 0
  },
  "model": {
    "type": "XGBoost",
    "n_estimators": 200,
    "max_depth": 3,
    "learning_rate": 0.03,
    "min_child_weight": 3,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "random_state": 42
  },
  "features": [
    "srtm_elevation_m",
    "srtm_slope_deg",
    "rainfall_24h_mm",
    "rainfall_3day_mm",
    "rainfall_7day_mm"
  ],
  "score": {
    "type": "XGBoost risk score",
    "calibrated_probability": false,
    "interpretation": "Model output used as a relative landslide risk score, not a calibrated real-world probability."
  },
  "operational_alert_policy": {
    "watch_threshold": 0.35,
    "alert_threshold": 0.5,
    "status": "configurable_operational_policy",
    "note": "Thresholds are configurable deployment policy and are not claimed to be universally optimal or scientifically calibrated."
  },
